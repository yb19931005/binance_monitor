# Binance 熬鹰资本 仓位监控 + TG推送

# 币安带单 portfolioId（熬鹰资本当前公开带单）
PORTFOLIO_ID=5075281354358777856

# 轮询间隔（秒），建议 30~90，过快容易限流
POLL_INTERVAL=45

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL
DATABASE_URL=postgresql://postgres:123456@localhost:5432/binance_monitor

# 日志级别
LOG_LEVEL=INFO

# 是否只推送名义价值超过此阈值的仓位变化（USDT，0=全部推送）
MIN_NOTIONAL_USDT=50000

# 可选 HTTP/SOCKS 代理（应对限流或网络问题），留空则直连
# PROXY=http://127.0.0.1:7890
PROXY=http://127.0.0.1:7897

# Web Dashboard
WEB_HOST=0.0.0.0
WEB_PORT=8080

# 健康检查：连续失败 N 次后推送 TG 告警
HEALTH_FAIL_THRESHOLD=3
